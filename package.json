{
  "name": "unreal-mcp-additional-tools",
  "version": "0.1.0",
  "description": "MCP server for Unreal Engine — 78 tools across 14 subsystems, complementing Epic's official Unreal MCP server",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "unreal-mcp-additional-tools": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/bin.ts",
    "build": "tsc",
    "start": "node dist/bin.js",
    "test": "vitest",
    "lint": "biome check src/",
    "fmt": "biome format --write src/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "unreal-remote-execution": "^1.0.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
